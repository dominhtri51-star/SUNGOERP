# ==========================================
# CẤU HÌNH HỆ THỐNG SUNGOERP
# ==========================================
PORT=3000

# ==========================================
# CẤU HÌNH GOOGLE DRIVE STORAGE (TÙY CHỌN)
# ==========================================
# Đường dẫn file key Service Account (Mặc định: config/google-service-account.json)
GOOGLE_DRIVE_KEY_PATH=config/google-service-account.json

# ID Thư mục lưu trữ trên Google Drive
# Lấy từ link: https://drive.google.com/drive/folders/1aBcDeFgHiJkLmNoPqRsTuVwXyZ
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
